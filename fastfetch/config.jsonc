{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/omarchy-eclipse.txt",
    "padding": {
      "top": 2,
      "right": 5,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "color": {
      "keys": "38;2;255;140;66",
      "title": "38;2;255;191;71",
      "output": "38;2;255;191;71",
      "separator": "38;2;193;18;31"
    },
    "percent": {
      "color": {
        "green": "38;2;255;140;66",
        "yellow": "38;2;255;191;71",
        "red": "38;2;255;69;58"
      }
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;193;18;31m┌──────────────────────Hardware──────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "38;2;255;140;66"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;193;18;31m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;193;18;31m┌──────────────────────Software──────────────────────┐\u001b[0m"
    },
    {
      "type": "command",
      "key": " OS",
      "keyColor": "38;2;255;69;58",
      "text": "version=$(omarchy-version) && echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "38;2;255;69;58",
      "text": "omarchy-version-branch"
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "38;2;255;69;58",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "38;2;255;69;58",
      "text": "theme=$(omarchy-theme-current); printf \"%s \\033[38;2;193;18;31m● \\033[38;2;255;69;58m● \\033[38;2;255;140;66m● \\033[38;2;255;191;71m●\\033[0m\\n\" \"$theme\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "38;2;255;69;58"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;193;18;31m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;193;18;31m┌────────────────Age / Uptime / Update───────────────┐\u001b[0m"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "38;2;255;191;71",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "38;2;255;191;71"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "38;2;255;191;71",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;193;18;31m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break"
  ]
}
